# 复制为 .env 后填写：cp .env.example .env

# 与 public-server/.env 一致
RELAY_HOST=relay.example.com
FRP_AUTH_TOKEN=

# 大模型服务地址：只写“协议://主机[:端口]”，不带路径
#   局域网服务：LLM_UPSTREAM=http://192.168.1.100:8000
#   外部服务：  LLM_UPSTREAM=https://api.example.com
LLM_UPSTREAM=http://192.168.1.100:8000

# 可选：后端地址的路径前缀，没有就留空
#   例：外部地址是 https://api.example.com/anthropic/v1/messages，就填 /anthropic
LLM_PATH_PREFIX=

# 大模型服务的真实 Key，二选一：
#   BACKEND_AUTH_HEADER=X-Api-Key      BACKEND_AUTH_VALUE=<key>
#   BACKEND_AUTH_HEADER=Authorization  BACKEND_AUTH_VALUE=Bearer <key>
BACKEND_AUTH_HEADER=X-Api-Key
BACKEND_AUTH_VALUE=
